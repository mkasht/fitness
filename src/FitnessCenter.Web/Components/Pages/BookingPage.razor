@page "/booking"
@inject CatalogService Catalog
@inject BookingService BookingService
@inject AuthenticationStateProvider Authentication
@inject ClubClock Clock
<PageTitle>Запись на тренировку · Пульс</PageTitle>
<section class="container section page-top"><span class="eyebrow">Твоё время для себя</span><h1>ВЫБИРАЙ ДВИЖЕНИЕ</h1><p class="page-lead">Найди удобное занятие. Время указано по Ижевску (UTC+4).</p>
<div class="booking-filters"><div><label for="booking-service">Направление</label><select id="booking-service" @bind="serviceId" @bind:after="ResetTrainer"><option value="0">Все направления</option>@foreach (var s in services) { <option value="@s.Id">@s.Name</option> }</select></div><div><label for="booking-trainer">Тренер</label><select id="booking-trainer" @bind="trainerId" @bind:after="Load"><option value="0">Любой тренер</option>@foreach (var t in trainers.Where(x => serviceId == 0 || x.Services.Any(s => s.Id == serviceId))) { <option value="@t.Id">@t.Name · @t.Specialty</option> }</select></div><div><label for="booking-date">Дата занятия</label><input type="date" id="booking-date" @bind="date" @bind:after="Load" min="@Clock.Now.ToString("yyyy-MM-dd")" /></div></div>
<div class="day-tabs" aria-label="Ближайшие дни">@foreach (var day in Enumerable.Range(0, 7).Select(i => Clock.Now.Date.AddDays(i))) { <button class="@(date.Date == day ? "selected" : "")" @onclick="() => SetDate(day)"><span>@day.ToString("ddd")</span><strong>@day.ToString("dd MMM")</strong></button> }</div>
@if (result is not null) { <div class="notice @(result.Success ? "" : "error")" role="status">@result.Message @if (result.Success) { <a class="text-link" href="/cabinet">Открыть кабинет ↗</a> }</div> }
@if (loading) { <p role="status">Ищем доступные занятия…</p> } else if (sessions.Count == 0) { <div class="empty-state"><h3>В этот день занятий пока нет</h3><p>Попробуй другую дату или другое направление.</p></div> } else { <div class="session-list">@foreach (var s in sessions) { var places = s.Capacity - s.Bookings.Count; <article class="session-row @(selected?.Id == s.Id ? "selected-session" : "")"><div class="session-time">@Clock.Local(s.StartsAtUtc).ToString("HH:mm")<small>до @Clock.Local(s.EndsAtUtc).ToString("HH:mm")</small></div><div><h3>@s.Service.Name</h3><p>@s.Service.Price.ToString("N0") ₽ · @s.Service.DurationMinutes мин</p></div><p>@s.Trainer.Name</p><span class="session-places">@(places > 0 ? $"Мест: {places}" : "Мест нет")</span><button class="button button-small" disabled="@(places <= 0 || busy)" @onclick="() => Select(s)">@(selected?.Id == s.Id ? "Выбрано" : "Выбрать ↗")</button></article> }</div> }
@if (selected is not null) { <section id="booking-confirm" class="booking-confirm" aria-label="Подтверждение записи"><h2>@selected.Service.Name</h2><p>@Clock.Local(selected.StartsAtUtc).ToString("d MMMM, HH:mm") · @selected.Trainer.Name</p><label for="booking-comment">Комментарий тренеру, необязательно</label><textarea id="booking-comment" @bind="comment" maxlength="1000" placeholder="Например, это моя первая тренировка"></textarea><AuthorizeView><Authorized><button class="button" disabled="@busy" @onclick="Confirm">@(busy ? "Сохраняем…" : "Подтвердить запись ↗")</button></Authorized><NotAuthorized><p>Войди или создай аккаунт, чтобы сохранить запись.</p><a class="button" href="@LoginUrl()">Войти и записаться ↗</a></NotAuthorized></AuthorizeView></section> }
</section>
@code {
    [SupplyParameterFromQuery] public int? ServiceId { get; set; }
    [SupplyParameterFromQuery] public int? TrainerId { get; set; }
    [SupplyParameterFromQuery] public int? SessionId { get; set; }
    [SupplyParameterFromQuery] public string? Date { get; set; }
    private int serviceId; private int trainerId; private DateTime date; private bool loading = true; private bool busy;
    private List<FitnessService> services = []; private List<Trainer> trainers = []; private List<TrainingSession> sessions = [];
    private TrainingSession? selected; private string comment = ""; private OperationResult? result;
    protected override async Task OnParametersSetAsync() {
        services = await Catalog.ServicesAsync(); trainers = await Catalog.TrainersAsync();
        serviceId = ServiceId ?? 0; trainerId = TrainerId ?? 0;
        date = DateTime.TryParseExact(Date, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : Clock.Now.Date;
        if (date < Clock.Now.Date || date == DateTime.MaxValue.Date) date = Clock.Now.Date;
        await Load(); selected = sessions.FirstOrDefault(s => s.Id == SessionId);
    }
    private async Task ResetTrainer() { trainerId = 0; await Load(); }
    private async Task SetDate(DateTime d) { date = d; await Load(); }
    private async Task Load() { loading = true; selected = null; sessions = await Catalog.SessionsAsync(new[] { Clock.Utc(date.Date), DateTime.UtcNow }.Max(), Clock.Utc(date.Date.AddDays(1)), serviceId == 0 ? null : serviceId, trainerId == 0 ? null : trainerId); loading = false; }
    private void Select(TrainingSession s) { selected = s; result = null; comment = ""; }
    private string LoginUrl() => "/Account/Login?ReturnUrl=" + Uri.EscapeDataString($"booking?ServiceId={serviceId}&TrainerId={trainerId}&Date={date:yyyy-MM-dd}&SessionId={selected?.Id}");
    private async Task Confirm() {
        if (busy || selected is null) return;
        busy = true;
        try { result = await BookingService.BookAsync((await Authentication.GetAuthenticationStateAsync()).User, selected.Id, comment); await Load(); }
        finally { busy = false; }
    }
}
