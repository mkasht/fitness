@page "/reviews"
@inject CatalogService Catalog
@inject BookingService BookingService
@inject AuthenticationStateProvider Authentication
@inject ClubClock Clock
<PageTitle>Отзывы · Пульс</PageTitle>
<section class="container section page-top"><span class="eyebrow">Впечатления участников</span><h1 id="published-reviews">ПОСЛЕ ТРЕНИРОВКИ</h1><p class="page-lead">Что понравилось, что получилось и к чему хочется вернуться.</p>
@if (reviews is null) { <p role="status">Загружаем отзывы…</p> } else if (reviews.Items.Count == 0) { <p>Опубликованных отзывов пока нет. Поделись впечатлениями после занятия.</p> } else { <div class="reviews-grid">@foreach (var r in reviews.Items) { <article class="review-card" id="@($"review-{r.Id}")"><span class="rating" aria-label="@($"Оценка {r.Rating} из 5")">@(new string('★', r.Rating))</span><blockquote>@r.Text</blockquote><p>@r.Booking.User.FullName · @r.Booking.Session.Service.Name<br />@Clock.Local(r.CreatedAtUtc).ToString("dd MMMM yyyy")</p></article> }</div> }
@if (reviews is { TotalPages: > 1 } pagination)
{
    <nav class="row-actions" aria-label="Страницы отзывов">
        @if (pagination.Number > 1) { <a class="text-link" href="@PageHref(pagination.Number - 1)">← Предыдущая</a> }
        <span>Страница @pagination.Number из @pagination.TotalPages</span>
        @if (pagination.Number < pagination.TotalPages) { <a class="text-link" href="@PageHref(pagination.Number + 1)">Следующая →</a> }
    </nav>
}
<div class="staff-form form-panel"><h2>Поделись впечатлениями</h2><AuthorizeView><Authorized>@if (visited.Count == 0) { <p>Оставить отзыв можно после посещения, отмеченного менеджером.</p><a class="text-link" href="/booking">Выбрать тренировку ↗</a> } else { @if (result is not null) { <div class="notice @(result.Success ? "" : "error")" role="status">@result.Message</div> }<form @onsubmit="Submit" @onsubmit:preventDefault><label for="review-session">Посещённое занятие</label><select id="review-session" @bind="bookingId">@foreach (var b in visited) { <option value="@b.Id">@b.Session.Service.Name · @Clock.Local(b.Session.StartsAtUtc).ToString("dd MMM")</option> }</select><label for="review-rating">Оценка</label><select id="review-rating" @bind="rating">@foreach (var n in Enumerable.Range(1, 5).Reverse()) { <option value="@n">@n из 5</option> }</select><label for="review-text">Отзыв</label><textarea id="review-text" @bind="text" maxlength="1500" required></textarea><button class="button" disabled="@busy" type="submit">Отправить на модерацию ↗</button></form> }</Authorized><NotAuthorized><p>Войди, чтобы оставить отзыв после посещения.</p><a class="button" href="/Account/Login?ReturnUrl=reviews">Войти в кабинет ↗</a></NotAuthorized></AuthorizeView></div></section>
@code {
    [SupplyParameterFromQuery] public int? BookingId { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery] public int? ReviewId { get; set; }
    private ReviewPage? reviews; private List<Booking> visited = []; private ClaimsPrincipal user = new(); private int bookingId; private int rating = 5; private string text = ""; private OperationResult? result; private bool busy;
    protected override async Task OnParametersSetAsync() { reviews = await Catalog.ReviewsAsync(PageNumber ?? 1, ReviewId); user = (await Authentication.GetAuthenticationStateAsync()).User; if (user.Identity?.IsAuthenticated == true) { visited = (await BookingService.MyBookingsAsync(user)).Where(b => b.Status == BookingStatus.Attended).ToList(); bookingId = visited.FirstOrDefault(b => b.Id == BookingId)?.Id ?? visited.FirstOrDefault()?.Id ?? 0; } }
    private string PageHref(int page) =>
        $"/reviews?page={page}{(BookingId is int id ? $"&BookingId={id}" : "")}#published-reviews";

    private async Task Submit() { if (busy) return; busy = true; try { result = await BookingService.AddReviewAsync(user, bookingId, rating, text); if (result.Success) text = ""; } finally { busy = false; } }
}

