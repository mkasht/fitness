@page "/services/{Id:int}"
@inject CatalogService Catalog
<PageTitle>@(service?.Name ?? "Услуга") · Пульс</PageTitle>
<section class="container section page-top">@if (loading) { <p role="status">Загружаем направление…</p> } else if (service is null) { <h1>Услуга не найдена</h1><a href="/services">Вернуться к направлениям</a> } else { <a class="breadcrumb" href="/services">← Все направления</a><div class="detail-grid"><div><span class="eyebrow">@service.Category</span><h1>@service.Name.ToUpper()</h1><p class="page-lead">@service.Summary</p><p>@service.Description</p><div class="detail-facts"><span>@service.DurationMinutes минут</span><strong>@service.Price.ToString("N0") ₽ за занятие</strong></div><a class="button" href="@($"/booking?ServiceId={Id}")">Записаться на тренировку ↗</a></div><img class="detail-image" src="@service.Image" alt="@service.Name" /></div><h2 class="subsection-title">С КЕМ ТРЕНИРУЕМСЯ</h2><div class="trainer-grid">@foreach (var t in service.Trainers) { <TrainerCard Trainer="t" /> }</div> }</section>
@code { [Parameter] public int Id { get; set; } private FitnessService? service; private bool loading = true; protected override async Task OnParametersSetAsync() { loading = true; service = await Catalog.ServiceAsync(Id); loading = false; } }
