
<div class="club-map">
    @if (ClubUrl("Club:MapUrl") is { } mapUrl)
    {
        <iframe title="Расположение клуба на карте" src="@mapUrl" loading="lazy" referrerpolicy="no-referrer"></iframe>
    }
    @if (ClubUrl("Club:DirectionsUrl") is { } directionsUrl)
    {
        <p><a class="text-link" href="@directionsUrl">Открыть адрес на карте <span aria-hidden="true">↗</span></a></p>
    }
</div>

@code {
    [CascadingParameter] private SiteContent Site { get; set; } = null!;
    private string? ClubUrl(string key) =>
        Uri.TryCreate(Site[key], UriKind.Absolute, out var url) && url.Scheme == Uri.UriSchemeHttps
            ? url.AbsoluteUri : null;
}
